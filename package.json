{
  "name": "skyfall-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n v1,v2,v3 -c blue,green,magenta \"npm:dev:v1\" \"npm:dev:v2\" \"npm:dev:v3\"",
    "dev:v1": "npm run dev -w @skyfall/v1-black",
    "dev:v2": "npm run dev -w @skyfall/v2-aeye",
    "dev:v3": "npm run dev -w @skyfall/v3-captain",
    "build": "npm run build -w @skyfall/v1-black -w @skyfall/v2-aeye -w @skyfall/v3-captain",
    "preview": "concurrently -k -n v1,v2,v3 -c blue,green,magenta \"npm run preview -w @skyfall/v1-black\" \"npm run preview -w @skyfall/v2-aeye\" \"npm run preview -w @skyfall/v3-captain\"",
    "lint": "oxlint",
    "test": "vitest run",
    "typecheck": "tsc -b packages/core apps/v1-black apps/v2-aeye apps/v3-captain"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.3"
  }
}
